<?xml version="1.0" encoding="utf-8"?>
<!-- 周网格课程卡片（矮档：≤60min 单节课）。结构同中档，名称限 2 行 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_margin="1dp"
    android:id="@+id/course_card_root">

    <ImageView
        android:id="@+id/card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_course_card_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="5dp">

        <TextView
            android:id="@+id/tv_card_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/widget_text_primary"
            android:textSize="11dp"
            android:textStyle="bold"
            tools:text="羽毛球" />

        <TextView
            android:id="@+id/tv_card_teacher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="10dp"
            tools:text="潘际娜" />

        <TextView
            android:id="@+id/tv_card_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="10dp"
            tools:text="@海阳馆一楼D区" />
    </LinearLayout>

    <ImageView
        android:id="@+id/card_highlight"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_course_card_stroke"
        android:visibility="gone" />
</FrameLayout>
